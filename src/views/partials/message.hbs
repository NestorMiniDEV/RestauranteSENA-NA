{{#if success}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div
          class="alert alert-success alert-dismissible fade show"
          role="alert"
        >
          {{success}}
          <span
            class="btn-close"
            type="button"
            data-bs-dismiss="alert"
            aria-label="Close"
          >
          </span>
        </div>
      </div>
    </div>
  </div>
{{/if}}

{{#if failure}}
  <div class="container p-4">
    <div class="row">
      <div class="col-md-4 mx-auto">
        <div
          class="alert alert-danger alert-dismissible fade show"
          role="alert"
        >
          {{failure}}
          <span
            class="btn-close"
            type="button"
            data-bs-dismiss="alert"
            aria-label="Close"
          >
          </span>
        </div>
      </div>
    </div>
  </div>
{{/if}}